package VampyreImagingPackage;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $7A00000}
{$DEFINE FULL_FEATURE_SET}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Vampyre Imaging Library Package'}
{$IMPLICITBUILD OFF}

requires
  rtl,
  vcl;

contains
  Imaging in '..\Source\Imaging.pas',
  ImagingBitmap in '..\Source\ImagingBitmap.pas',
  ImagingCanvases in '..\Source\ImagingCanvases.pas',
  ImagingClasses in '..\Source\ImagingClasses.pas',
  ImagingColors in '..\Source\ImagingColors.pas',
  ImagingComponents in '..\Source\ImagingComponents.pas',
  ImagingDds in '..\Source\ImagingDds.pas',
  ImagingFormats in '..\Source\ImagingFormats.pas',
  ImagingGif in '..\Source\ImagingGif.pas',
  ImagingIO in '..\Source\ImagingIO.pas',
  ImagingJpeg in '..\Source\ImagingJpeg.pas',
  ImagingNetworkGraphics in '..\Source\ImagingNetworkGraphics.pas',
  ImagingPortableMaps in '..\Source\ImagingPortableMaps.pas',
  ImagingRadiance in '..\Source\ImagingRadiance.pas',
  ImagingTarga in '..\Source\ImagingTarga.pas',
  ImagingTypes in '..\Source\ImagingTypes.pas',
  ImagingUtility in '..\Source\ImagingUtility.pas',
  ImagingExtFileFormats in '..\Extensions\ImagingExtFileFormats.pas',
  ImagingJpeg2000 in '..\Extensions\ImagingJpeg2000.pas',
  ImagingPcx in '..\Extensions\ImagingPcx.pas',
  ImagingPsd in '..\Extensions\ImagingPsd.pas',
  ImagingTiff in '..\Extensions\ImagingTiff.pas',
  ImagingXpm in '..\Extensions\ImagingXpm.pas',
  ImagingZLib in '..\Source\ZLib\ImagingZLib.pas',
  ImPasZLib in '..\Source\ZLib\ImPasZLib.pas',
  ImagingJpegLib in '..\Source\JpegLib\ImagingJpegLib.pas',
  ImPasJpeg in '..\Source\JpegLib\ImPasJpeg.pas',
  ImagingTiffLib in '..\Extensions\LibTiff\ImagingTiffLib.pas',
  ElderImagery in '..\Extensions\ElderImagery.pas',
  ElderImageryBsi in '..\Extensions\ElderImageryBsi.pas',
  ElderImageryCif in '..\Extensions\ElderImageryCif.pas',
  ElderImageryImg in '..\Extensions\ElderImageryImg.pas',
  ElderImagerySky in '..\Extensions\ElderImagerySky.pas',
  ElderImageryTexture in '..\Extensions\ElderImageryTexture.pas';

end.
